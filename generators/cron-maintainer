## /usr/local/bin: fxLinkBin puts the zzfirewall-generate command there
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
SHELL=/bin/bash
MAILTO=''

## Lists update. The log keeps the last run only (overwritten every time)
30 10 * * * root zzfirewall-generate > /var/log/turbolab.it/zzfirewall_cron-generate-lists.log 2>&1


## 👇 If the last entry is missing a newline, cron will consider it broken and refuse to run it 👇
